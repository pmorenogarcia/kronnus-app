# Kronnus API base URL
# iOS Simulator:    http://localhost:8080
# Android Emulator: http://10.0.2.2:8080
# Physical device:  http://<your-machine-lan-ip>:8080  (e.g. http://192.168.1.100:8080)
EXPO_PUBLIC_API_URL=http://localhost:8080

# Firebase credentials (EAS cloud builds only)
# Set via: eas env:create --scope project --name GOOGLE_SERVICES_JSON_BASE64 --value "$(base64 -w 0 ./google-services.json)" --visibility secret --environment <development|preview|production>
# Locally, place google-services.json in the project root (gitignored).
# GOOGLE_SERVICES_JSON_BASE64=
